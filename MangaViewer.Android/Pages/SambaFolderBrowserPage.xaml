<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MangaViewer.Android.Models"
             x:Class="MangaViewer.Android.Pages.SambaFolderBrowserPage"
             Title="SAMBAブラウザ">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10" RowSpacing="8">
        <Label x:Name="PathLabel" Grid.Row="0" FontSize="12" TextColor="#808080" />
        <Label x:Name="StatusLabel" Grid.Row="1" FontSize="12" TextColor="#B0B0B0" />

        <CollectionView x:Name="FolderList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BrowserItem">
                    <Grid Padding="6,8">
                        <Label Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <Button Text="開く" Clicked="OnOpenClicked" />
            <Button Text="このフォルダを選択" Clicked="OnSelectClicked" />
            <Button Text="キャンセル" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
