<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MangaViewer.Android.MainPage"
             Title="MangaViewer Android">

    <Grid RowDefinitions="*,Auto" Padding="8" RowSpacing="8">
        <Grid x:Name="MainGrid" Grid.Row="0" ColumnDefinitions="3.6*,3.6*,2.8*" ColumnSpacing="8">
            <Border Stroke="#404040" Background="#181818" StrokeShape="RoundRectangle 8" Padding="8" Grid.Column="0">
                <Grid RowDefinitions="Auto,*">
                    <Label Text="左ページ" TextColor="#CCCCCC" FontSize="12" />
                    <Image x:Name="LeftImage"
                           Grid.Row="1"
                           Source="dotnet_bot.png"
                           Aspect="AspectFit"
                           VerticalOptions="Fill"
                           HorizontalOptions="Fill" />
                </Grid>
            </Border>

            <Border Stroke="#404040" Background="#121212" StrokeShape="RoundRectangle 8" Padding="8" Grid.Column="1">
                <Grid RowDefinitions="Auto,*">
                    <Label Text="右ページ" TextColor="#CCCCCC" FontSize="12" />
                    <Image x:Name="RightImage"
                           Grid.Row="1"
                           Source="dotnet_bot.png"
                           Aspect="AspectFit"
                           VerticalOptions="Fill"
                           HorizontalOptions="Fill" />
                </Grid>
            </Border>

            <Grid x:Name="RightPanel" Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="8">
                <Border Stroke="#404040" Background="#0E0E0E" StrokeShape="RoundRectangle 8" Padding="8" Grid.Row="0">
                    <Grid RowDefinitions="Auto,*">
                        <Label Text="フォルダ/巻リスト" TextColor="#CCCCCC" FontSize="12" />
                        <CollectionView x:Name="FolderList"
                                        Grid.Row="1"
                                        SelectionMode="Single"
                                        SelectionChanged="OnFolderSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6">
                                        <Label Text="{Binding .}" TextColor="#E6E6E6" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <Border Stroke="#404040" Background="#111111" StrokeShape="RoundRectangle 8" Padding="8" Grid.Row="1">
                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                        <Button Grid.Row="0" Grid.Column="0" Text="7" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="0" Grid.Column="1" Text="8" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="0" Grid.Column="2" Text="9" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="0" Grid.Column="3" Text="CTRL" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="0" Grid.Column="4" Text="ALT" Clicked="OnVirtualKeyClicked" />

                        <Button Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="1" Grid.Column="3" Text="↑" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="1" Grid.Column="4" Text="+" Clicked="OnVirtualKeyClicked" />

                        <Button Grid.Row="2" Grid.Column="0" Text="1" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="2" Grid.Column="1" Text="2" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="2" Grid.Column="2" Text="3" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="2" Grid.Column="3" Text="←" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="2" Grid.Column="4" Text="→" Clicked="OnVirtualKeyClicked" />

                        <Button Grid.Row="3" Grid.Column="0" Text="0" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="3" Grid.Column="1" Text="A" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="3" Grid.Column="2" Text="S" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="3" Grid.Column="3" Text="↓" Clicked="OnVirtualKeyClicked" />
                        <Button Grid.Row="3" Grid.Column="4" Text="L" Clicked="OnVirtualKeyClicked" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Label x:Name="ModifierLabel" Text="MOD: -" FontSize="12" TextColor="#707070" />
            <Label x:Name="ModeLabel" Grid.Column="1" Text="MODE: Folder" FontSize="12" TextColor="#707070" />
            <Label x:Name="StatusLabel" Grid.Column="2" Text="READY" FontSize="12" TextColor="#B0B0B0" />
            <Label x:Name="DownloadLabel" Grid.Column="3" Text="DL: 待機" FontSize="12" TextColor="#F0C674" />
        </Grid>
    </Grid>

</ContentPage>
