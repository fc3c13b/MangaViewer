<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <HighDpiMode>PerMonitorV2</HighDpiMode>
    <DefineConstants>USE_SKIA</DefineConstants>

    <!-- バ�Eジョンの唯一の定義�E�Esproj�E�E-->
    <Version>0.0.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <!-- SDK ぁEAssemblyInformationalVersion を�E動付与し、Constants.GetAppVersion() で正しく取得可能にする -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
  </ItemGroup>

  <!-- Exclude test projects and Android MAUI project from the Windows app project -->
  <ItemGroup>
    <Compile Remove="TestDbLoader\**" />
    <Compile Remove="DbTestApp\**" />
    <Compile Remove="MangaViewer.Android\**\*" />
    <None Remove="MangaViewer.Android\**\*" />
    <Page Remove="MangaViewer.Android\**\*" />
  </ItemGroup>

</Project>
