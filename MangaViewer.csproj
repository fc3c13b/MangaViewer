<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <HighDpiMode>PerMonitorV2</HighDpiMode>
    <DefineConstants>USE_SKIA</DefineConstants>

    <!-- バージョンの唯一の定義（csproj） -->
    <Version>0.9.32</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <!-- 自動生成される AssemblyInfo との重複を防ぐ -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
  </ItemGroup>

  <!-- Exclude test projects from main project -->
  <ItemGroup>
    <Compile Remove="TestDbLoader\**" />
    <Compile Remove="DbTestApp\**" />
  </ItemGroup>

</Project>
